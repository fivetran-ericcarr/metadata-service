# Fivetran
FIVETRAN_API_KEY=
FIVETRAN_API_SECRET=
FIVETRAN_GROUP_ID=
FIVETRAN_BASE_URL=https://api.fivetran.com/v1

# dbt Platform / dbt Cloud
DBT_ACCOUNT_ID=
DBT_SERVICE_TOKEN=
DBT_BASE_URL=https://cloud.getdbt.com/api
DBT_METADATA_API_URL=

# Storage
METADATA_STORAGE_BACKEND=local
METADATA_LOCAL_PATH=./metadata_snapshots
METADATA_S3_BUCKET=
METADATA_S3_PREFIX=metadata
# Keep at most N timestamped snapshots (latest.json never pruned; unset = keep all).
METADATA_RETENTION_SNAPSHOTS=

# Service
LOG_LEVEL=INFO
# Defaults to loopback: the snapshot is a full warehouse inventory. To serve
# remotely, set API_HOST=0.0.0.0 AND set METADATA_API_KEY.
API_HOST=127.0.0.1
API_PORT=8080
# When set, every REST route except /health requires this key
# (X-API-Key header, or Authorization: Bearer <key>).
METADATA_API_KEY=

# MCP server (stdio for local agents; http/sse for hosted/remote agents).
# HTTP transports have no auth — keep loopback or front with a reverse proxy.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8765

# Data Quality
# Optional OVERRIDE for the warehouse dialect. Leave as `warehouse` (the
# placeholder) to auto-detect it from the Fivetran destination's `service`.
# Set explicitly (snowflake | redshift | postgres | sql_server | bigquery |
# databricks) only to override detection. Object IDs are always `warehouse://`
# and are not affected by this.
WAREHOUSE_TYPE=warehouse
# Flag a Fivetran sync as stale if last_successful_sync is older than this many hours
STALE_SYNC_THRESHOLD_HOURS=24

# Warehouse metadata reader (optional) — reads authoritative PKs/lineage from the
# Fivetran Platform Connector's fivetran_metadata schema, and column
# data_type/max_length/nullable from the destination's INFORMATION_SCHEMA.
# The dialect and database are auto-detected from the Fivetran destination
# (requires FIVETRAN_GROUP_ID); the settings below override detection.
# The CREDENTIAL is never auto-detected — Fivetran masks every password-format
# destination config field — so USER + (PASSWORD or PRIVATE_KEY_PATH) are
# required to enable the reader. Grant the role read-only access.
# Install: pip install 'metadata-service[warehouse-snowflake]'
# Snowflake is the only dialect with a reader today.
WAREHOUSE_ACCOUNT=
WAREHOUSE_USER=
WAREHOUSE_ROLE=
WAREHOUSE_NAME=
WAREHOUSE_DATABASE=
WAREHOUSE_METADATA_SCHEMA=fivetran_metadata
WAREHOUSE_PRIVATE_KEY_PATH=
# Set when the key above is passphrase-protected.
WAREHOUSE_PRIVATE_KEY_PASSPHRASE=
WAREHOUSE_PASSWORD=

# --- Fivetran Activations (reverse ETL) readiness gate -------------------------
# Census-based Activations API. Set the workspace access token to enable the gate.
# Syncs are scoped to those reading WAREHOUSE_DATABASE (above).
ACTIVATIONS_API_TOKEN=
ACTIVATIONS_BASE_URL=https://app.getcensus.com/api/v1
