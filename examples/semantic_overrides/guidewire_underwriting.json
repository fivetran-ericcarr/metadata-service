  "metric_notes": {
    "written_premium": "Excludes unbound quotes and quotes with a blocking data-quality issue (is_premium_trusted = false).",
    "bind_rate": "Defined per QUOTE (bound quotes / all quotes). underwriting_funnel.submission_bind_rate is per SUBMISSION (bound / quoted submissions) and is a different number.",
    "bound_quotes": "Bound quotes whose premium is quarantined still count as bound.",
    "cancellation_rate": "Denominator is bound quotes (including bound quotes whose premium is quarantined); numerator is bound quotes whose policy has a Completed cancellation.",
    "avg_endorsement_premium_change_pct": "Averages premium_change_pct over all policy changes (endorsements, renewals, reinstatements, new-business issuance); cancellations carry no premium_change_pct and are ignored.",
    "total_quoted_premium": "Includes untrusted (negative or non-reconciling) quote premiums -- not written premium."
  },
  "dq_rules": [
    {
      "id": "INVALID_RATED_STATE",
      "pattern": "accepted_values_pd_state_rating_state_code",
      "short": "{n} rated states invalid in PolicyDecision WKSTATE.STATECD (e.g. 'XX') -> reported as rated_state_code UNKNOWN in state_hazard_rating and NULL in quotes"
    },
    {
      "id": "NEGATIVE_PREMIUM",
      "pattern": "accepted_range_gw_quote_total_premium",
      "short": "{n} negative-premium quotes are quarantined and excluded from written_premium",
      "metrics": [
        "written_premium"
      ]
    },
    {
      "id": "BREAKDOWN_MISMATCH",
      "pattern": "sum_matches_parent_gw_quote_line_item",
      "short": "{n} quotes whose premium line items do not reconcile are quarantined and excluded from written_premium",
      "metrics": [
        "written_premium"
      ]
    },
    {
      "id": "DUPLICATE_RATING_KEY",
      "pattern": "unique_combination_of_columns_.*(wkpolicy|pd_policy_rating)",
      "short": "{n} PolicyDecision WKPOLICY natural keys are duplicated; gold keeps the latest-synced copy"
    },
    {
      "id": "MISSING_EMAIL",
      "pattern": "not_null_gw_account_email",
      "short": "{n} accounts have no primary email (has_email = false)"
    },
    {
      "id": "ORPHAN_ACCOUNT",
      "pattern": "relationships_gw_submission_account_id",
      "short": "{n} submissions reference a non-existent account -> rolled up to the Unknown account (account_id = -1)"
    },
    {
      "id": "UNLINKED_RATING",
      "pattern": "relationships_pd_policy_pointer_quote_id",
      "short": "{n} PolicyDecision ratings point at a Guidewire quote that does not exist (unlinked_rating_count)"
    }
  ],
  "out_of_scope": {
    "source_schemas": [
      "guidewire_cda"
    ],
    "model_names": [
      "fct_claim",
      "mart_claims_summary"
    ],
    "model_prefixes": [
      "cc_"
    ]
  },
  "guidance": [
    "Prefer the governed dbt metrics (written_premium, quote_count, bound_quotes, bind_rate, avg_premium_change_pct, cancelled_policies, cancellation_rate, avg_endorsement_premium_change_pct) over re-deriving them.",
    "Written premium / GWP always means the written_premium metric (bound and trusted quotes). Never sum quoted_premium for written premium.",
    "Legacy PolicyDecision column codes (RISKGRADECD, STATECD, HIGHBESTHAZGROUPCD, ...) are synonyms of the readable columns; map them and say which readable column you used.",
    "Never filter out NULL or UNKNOWN groups: keep them so data-quality gaps stay visible.",
    "For excluded or quarantined records use is_premium_trusted = FALSE with dq_rule_ids, and the dq_quarantine register."
  ]
}